# SPDX-License-Identifier: Apache-2.0
# Baseline restrictions adapted from github.com/moby/profiles/apparmor/template.go.
# Optional Linux deployment policy, not a grant of container capabilities.
abi <abi/3.0>,
#include <tunables/global>

profile paperclip-control flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  network,
  deny network ax25,
  deny network ipx,
  deny network appletalk,
  deny network netrom,
  deny network rose,
  deny network econet,
  deny network atmsvc,
  deny network irda,
  deny network wanpipe,
  deny network isdn,
  deny network caif,
  deny network alg,
  deny network vsock,
  capability,
  file,
  umount,
  deny mount,
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=paperclip-control,
  signal (send) peer=paperclip-agent,
  ptrace (read,trace,readby,tracedby) peer=paperclip-control,
  ptrace (read,trace) peer=paperclip-agent,
  change_profile -> paperclip-agent,
  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,
}

profile paperclip-agent flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  network,
  deny network ax25,
  deny network ipx,
  deny network appletalk,
  deny network netrom,
  deny network rose,
  deny network econet,
  deny network atmsvc,
  deny network irda,
  deny network wanpipe,
  deny network isdn,
  deny network caif,
  deny network alg,
  deny network vsock,
  capability,
  file,
  umount,
  deny mount,
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (receive) peer=paperclip-control,
  signal (send,receive) peer=paperclip-agent,
  # Parent can observe/cancel its child. Agents cannot inspect the parent or
  # each other, nor transition back to the control profile on another exec.
  ptrace (readby,tracedby) peer=paperclip-control,
  # Prevent moving a protected ancestor and reading its files by a new path.
  # Existing provider/workspace subdirectories remain writable below it.
  deny /paperclip wklx,
  deny /paperclip/{instances,instances/*,instances/*/data,.paperclip,.config,.local} wklx,
  deny /paperclip/.local/bin{,/**} wklx,
  deny @{PROC}/*/environ r,
  deny @{PROC}/*/mem rw,
  deny /paperclip/instances/*/secrets{,/**} rwklx,
  deny /paperclip/instances/*/{config.json,.env,.env.*,db,db/**,data/backups,data/backups/**,logs,logs/**} rwklx,
  deny /paperclip/.env{,.*} rwklx,
  deny /paperclip/plugins{,/**} wklx,
  deny /paperclip/.paperclip/plugins{,/**} wklx,
  deny /paperclip/{.gitconfig,.git-credentials,.npmrc,.profile,.bashrc,.bash_profile,.zshrc,.zprofile,.pam_environment} wklx,
  deny /paperclip/.config/{git,npm}{,/**} wklx,
  deny /paperclip/.ssh{,/**} wklx,
  deny /app/.env{,.*} rwklx,
  # Live control-plane code is not a development checkout. Keep provider
  # execution/read access, but prevent dependency/code replacement by agents.
  deny /app/** wkl,
  deny /run/docker.sock rw,
  deny /var/run/docker.sock rw,
  deny /run/containerd/*.sock rw,
  deny /var/run/containerd/*.sock rw,
  deny /opt/paperclip-runner-wake/** rw,
  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,
}
