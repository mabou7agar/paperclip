tests {
  bru.deleteVar("fixtureDrainedAt");
  test("Fixture task drain is active", () => {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().draining).to.equal(true);
    bru.setVar("fixtureDrainedAt", Date.now());
  });
