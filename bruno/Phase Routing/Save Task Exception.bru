meta {
  name: Save Task Exception
  type: http
  seq: 4
}
put {
  url: {{baseUrl}}/api/v1/companies/{{companyId}}/phase-routing
  body: json
  auth: bearer
}
auth:bearer {
  token: {{boardToken}}
}
body:json {
  {
    "enabled": true,
    "planning": [{"id":"claude","adapterType":"claude_local","model":"claude-opus-5-5","binding":{"mode":"responsible_user","provider":"anthropic","method":"subscription"}}],
    "implementation": [{"id":"codex","adapterType":"codex_local","model":"gpt-6.1-sol","binding":{"mode":"responsible_user","provider":"openai","method":"subscription"}}],
    "review": [{"id":"claude-review","adapterType":"claude_local","model":"claude-opus-5-5","binding":{"mode":"responsible_user","provider":"anthropic","method":"subscription"}}],
    "taskOverrides": {
      "{{taskId}}": {
        "review": [{"id":"eligible-review","adapterType":"codex_local","model":"gpt-6-astra","binding":{"mode":"responsible_user","provider":"openai","method":"subscription"}}]
      }
    }
  }
}
docs {
  PUT replaces the complete company policy. GET and preserve existing defaults, role mappings,
  bindings and exceptions before editing. Set taskId to an actual task UUID. Confirm the frozen
  author's provider and review eligibility before adding a review fallback. This request does
  not change review authorization or approve a task.
}
