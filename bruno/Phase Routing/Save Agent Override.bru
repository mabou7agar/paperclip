meta {
  name: Save Agent Override
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/agents/{{agentId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{boardToken}}
}

body:json {
  {
    "runtimeConfig": {
      "executionResponsibility": "implementation",
      "aiConnection": {
        "provider": "anthropic",
        "method": "subscription",
        "mode": "responsible_user"
      },
      "phaseRouting": {
        "enabled": true,
        "planning": [
          {
            "id": "claude",
            "adapterType": "claude_local",
            "model": "claude-opus-5-5",
            "binding": {
              "provider": "anthropic",
              "method": "subscription",
              "mode": "responsible_user"
            }
          },
          {
            "id": "astra",
            "adapterType": "codex_local",
            "model": "gpt-6-astra",
            "binding": {
              "provider": "openai",
              "method": "subscription",
              "mode": "responsible_user"
            }
          }
        ],
        "implementation": [
          {
            "id": "codex",
            "adapterType": "codex_local",
            "model": "gpt-6.1-sol",
            "binding": {
              "provider": "openai",
              "method": "subscription",
              "mode": "responsible_user"
            }
          }
        ],
        "unknownResetCooldownSeconds": 3600
      }
    }
  }
}

tests {
  test("saves an agent planning fallback", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().runtimeConfig.executionResponsibility).to.equal("implementation");
    expect(res.getBody().runtimeConfig.phaseRouting.planning[1].model).to.equal("gpt-6-astra");
    expect(res.getBody().runtimeConfig.phaseRouting.implementation[0].model).to.equal("gpt-6.1-sol");
  });
}

docs {
  Uses the existing compatible agent-update endpoint. Retrieve the agent first
  and retain its complete runtimeConfig, including heartbeat and other settings,
  before sending this example. Choose accessible connections for every profile.
  Phase-only changes validate account/model access without re-probing an unchanged
  regular connection. Actual regular connection, model, harness and environment
  changes still require the normal connection checks.
}
