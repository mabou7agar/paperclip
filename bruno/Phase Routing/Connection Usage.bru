meta {
  name: Connection usage and renewal
  type: http
  seq: 3
}
get {
  url: {{baseUrl}}/api/v1/companies/{{companyId}}/phase-routing/usage
  body: none
  auth: bearer
}
auth:bearer {
  token: {{boardToken}}
}
tests {
  test("returns shared connection window status", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().connections).to.be.an("array");
    for (const connection of res.getBody().connections) {
      expect(connection.connectionId).to.be.a("string");
      expect(connection.blocked).to.be.a("boolean");
      expect(connection.windows).to.be.an("array");
    }
  });
}
