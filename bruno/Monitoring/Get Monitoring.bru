meta {
  name: Get Monitoring
  type: http
  seq: 1
}
get {
  url: {{baseUrl}}/api/v1/companies/{{companyId}}/monitoring
  body: none
  auth: inherit
}

docs {
  Alert-only observations are consumed once through native monitor claims and
  expiry handling. Issue state retains the previous attempt count. Audit receipts
  record the attempted count and include reportOnly: true. Repeated reads do not wake agents or reset monitor bounds.
  Explicit bounded task continuations and quota renewal keep their normal paths.
}
