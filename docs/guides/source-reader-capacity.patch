@@ -0,0 +1,84 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtemp, writeFile, rm, mkdir } from 'node:fs/promises';
+import { existsSync } from 'node:fs';
+import { execFileSync } from 'node:child_process';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { Memory } from './memory.mjs';
+
+const scope = {companyId:'capacity-company',projectId:'capacity-project',repositoryId:'capacity-repository'};
+const limits = {maxFiles:20,maxFileBytes:256000,maxBytes:10};
+const env = {...process.env,GIT_CONFIG_NOSYSTEM:'1',GIT_CONFIG_GLOBAL:'/dev/null',GIT_TERMINAL_PROMPT:'0'};
+async function fixture(run) {
+  const root = await mkdtemp(path.join(tmpdir(),'source-capacity-'));
+  const repo = path.join(root,'repo'), state = path.join(root,'state'); await mkdir(repo);
+  const git = (...args) => execFileSync('git',['-c','core.hooksPath=/dev/null','-c','core.fsmonitor=false','-C',repo,...args],{env,encoding:'utf8'}).trim();
+  try {
+    git('init','--quiet'); git('config','user.name','Capacity fixture'); git('config','user.email','fixture@example.invalid');
+    for (const [file,content] of [['a.ts','alpha\n'],['b.ts','beta\n'],['c.ts','gamma\n']]) await writeFile(path.join(repo,file),content);
+    git('add','.'); git('commit','--quiet','-m','Immutable capacity fixture');
+    const revision = git('rev-parse','HEAD');
+    const open = options => new Memory({state,bindings:[{scope,root:repo}],limits,...options});
+    await run({root,state,revision,open});
+  } finally { await rm(root,{recursive:true,force:true}); }
+}
+
+test('aggregate budget resumes a committed cursor without changing its file plan or rereading completed blobs', () => fixture(async ({revision,open}) => {
+  let memory = open(); let before;
+  try {
+    const partial = await memory.refresh(scope,{oneBatch:true,batchSize:1});
+    assert.equal(partial.cursor,1); assert.equal(partial.status,'indexing'); assert.equal(memory.reads,1);
+    before = memory.repository.sourcePlan(scope,revision);
+  } finally { memory.close(); }
+  memory = open({maxContentBytes:32});
+  try {
+    const result = await memory.refresh(scope,{batchSize:1});
+    assert.equal(result.status,'complete'); assert.equal(result.cursor,3); assert.equal(result.blobReads,2);
+    assert.deepEqual(memory.repository.sourcePlan(scope,revision),before);
+    const manifest=memory.repository.manifest(scope,revision);
+    assert.equal(manifest.maxContentBytes,32); assert.equal(manifest.bytes,17);
+    const duplicate=await memory.refresh(scope);
+    assert.equal(duplicate.status,'unchanged'); assert.equal(duplicate.blobReads,0);
+  } finally { memory.close(); }
+}));
+
+test('omitted budget retains the default hard stop and committed partial manifest', () => fixture(async ({revision,open}) => {
+  const memory=open();
+  try {
+    await memory.refresh(scope,{oneBatch:true,batchSize:1});
+    await assert.rejects(memory.refresh(scope,{batchSize:1}),e=>e.code==='INDEX_BUDGET');
+    const manifest=memory.repository.manifest(scope,revision);
+    assert.equal(manifest.cursor,1); assert.equal(manifest.status,'indexing');
+    assert.equal(Object.hasOwn(manifest,'maxContentBytes'),false);
+  } finally {memory.close();}
+}));
+
+test('a reduced aggregate budget rejects an unchanged complete index without deleting it', () => fixture(async ({revision,open}) => {
+  let memory=open({maxContentBytes:32});
+  try {await memory.refresh(scope,{batchSize:1});} finally {memory.close();}
+  memory=open({maxContentBytes:8});
+  try {
+    await assert.rejects(memory.refresh(scope),e=>e.code==='INDEX_BUDGET');
+    assert.equal(memory.reads,0);assert.equal(memory.repository.manifest(scope,revision).status,'complete');
+    assert.equal(memory.repository.documents(scope,revision).length,3);
+  } finally {memory.close();}
+}));
+
+test('aggregate capacity cannot disguise a changed filtering limit', () => fixture(async ({revision,open}) => {
+  let memory=open();let before;
+  try {await memory.refresh(scope,{oneBatch:true,batchSize:1});before=memory.repository.sourcePlan(scope,revision);} finally {memory.close();}
+  memory=open({maxContentBytes:32,limits:{...limits,maxFileBytes:128000}});
+  try {
+    await assert.rejects(memory.refresh(scope,{batchSize:1}),e=>e.code==='MANIFEST_CHANGED');
+    assert.deepEqual(memory.repository.sourcePlan(scope,revision),before);
+    assert.equal(memory.reads,0);assert.equal(memory.repository.manifest(scope,revision).cursor,1);
+  } finally {memory.close();}
+}));
+
+test('invalid aggregate capacity refuses before creating a state directory', () => fixture(async ({state,open}) => {
+  for (const value of [0,-1,1.5,'32',Number.MAX_SAFE_INTEGER+1]) {
+    assert.throws(()=>open({maxContentBytes:value}),e=>e.code==='INVALID_REQUEST');
+    assert.equal(existsSync(state),false);
+  }
+}));
